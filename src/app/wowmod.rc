// 应用资源：清单 + 版本信息。
// 清单必须编译进 exe（放同名文件在旁边是不生效的）。
#include <winver.h>

1 24 "wowmod.manifest"     // 24 = RT_MANIFEST，1 = CREATEPROCESS_MANIFEST_RESOURCE_ID

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "wowmod"
            VALUE "FileDescription",  "wowmod - WoW 12.0.7 mod loader"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "wowmod"
            VALUE "OriginalFilename", "wowmod.exe"
            VALUE "ProductName",      "wowmod mod loader"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
