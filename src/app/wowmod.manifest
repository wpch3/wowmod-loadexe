<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="wowmod.app" version="1.0.0.0" processorArchitecture="amd64"/>

  <!--
    为什么需要清单：
      1. 不声明 DPI 感知，Windows 会在 125%/150% 缩放下把整个窗口
         位图放大 —— 中文全糊。PerMonitorV2 由系统按真实像素渲染。
      2. Common Controls v6 才能拿到现代控件外观（否则是 Win95 风格按钮）。
      3. UTF-8 活动代码页 + 长路径：模组目录常常很深（多个中文/空格目录），
         超过 260 字符时没有 longPathAware 会直接打开失败。
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0" processorArchitecture="amd64"
                        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- asInvoker：不需要管理员权限。改了会触发 UAC 提示，
             而挂起创建游戏进程 / 读写其内存都不需要提权。 -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
